node_modules/
.npm/
.pnpm-store/
.yarn/

# Local configuration and secrets
.env
.env.*
!.env.example
!.env.template
*.local

# Logs, temporary files, and runtime state
*.log
logs/
tmp/
temp/
*.pid
*.sock

# Build and test output
build/
dist/
coverage/
test-results/
playwright-report/

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Backup and patch leftovers
*.bak
*.orig
*.rej
